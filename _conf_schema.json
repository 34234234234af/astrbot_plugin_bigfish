{
  "command_names": {
    "description": "主指令名",
    "type": "list",
    "default": ["鱼"],
    "hint": "可以填多个，例如 [\"鱼\", \"小鱼\", \"钓鱼\"]。内置的 鱼/fish/钓鱼/大鱼 永远可用，这里的词是额外加的。",
    "obvious_hint": true
  },
  "sub_commands": {
    "description": "子指令词（可自己改）",
    "type": "object",
    "hint": "同一个功能可以写多个同义词，用 | 分隔，例如「开黑|来一把」。留空则用默认词；默认词始终兼容。",
    "items": {
      "open": {
        "description": "开房",
        "type": "string",
        "default": "开房",
        "hint": "例：开黑|来一把|组团"
      },
      "join": {
        "description": "加入",
        "type": "string",
        "default": "加入"
      },
      "status": {
        "description": "状态",
        "type": "string",
        "default": "状态"
      },
      "close": {
        "description": "关房",
        "type": "string",
        "default": "关房"
      },
      "selfplay": {
        "description": "自己玩",
        "type": "string",
        "default": "自己玩"
      },
      "stats": {
        "description": "战绩",
        "type": "string",
        "default": "战绩"
      },
      "board": {
        "description": "排行",
        "type": "string",
        "default": "排行"
      },
      "help": {
        "description": "帮助",
        "type": "string",
        "default": "帮助"
      }
    }
  },
  "relay_mode": {
    "description": "中继跑在哪里",
    "type": "string",
    "default": "local",
    "options": ["local", "external"],
    "labels": ["插件自建（AstrBot 所在服务器）", "外部中继（我自己的电脑）"],
    "subtitles": ["最省事，什么都不用额外配", "电脑不开机就没人能玩；需填下面的公网地址"],
    "hint": "选 external 后，在自己电脑上运行插件目录里的 relay_server.py（或双击 中继-启动并穿隧道.bat），再把隧道地址填到「公网访问地址」。",
    "obvious_hint": true
  },
  "relay_host": {
    "description": "中继监听地址",
    "type": "string",
    "default": "0.0.0.0",
    "hint": "一般不用改。放在 Nginx 后面时保持 0.0.0.0 或 127.0.0.1。"
  },
  "relay_port": {
    "description": "中继端口",
    "type": "int",
    "default": 8317,
    "hint": "需要在服务器/安全组放行这个端口（除非前面套了反向代理）。改完要重载插件。"
  },
  "public_base_url": {
    "description": "公网访问地址",
    "type": "string",
    "default": "",
    "hint": "例如 https://fish.example.com。外部中继模式下必须填你电脑那条隧道地址，如 https://xxx.trycloudflare.com。",
    "obvious_hint": true
  },
  "max_players": {
    "description": "每个房间最多几个真人",
    "type": "int",
    "default": 2,
    "slider": {"min": 1, "max": 8, "step": 1},
    "hint": "bot 不占位置。2 就是一局双人。"
  },
  "match_seconds": {
    "description": "单局时长（秒）",
    "type": "int",
    "default": 90,
    "slider": {"min": 30, "max": 300, "step": 10}
  },
  "room_ttl_minutes": {
    "description": "空房间保留时长（分钟）",
    "type": "int",
    "default": 180,
    "slider": {"min": 10, "max": 1440, "step": 10}
  },
  "bot_plays": {
    "description": "开房时让 bot 进房一起玩",
    "type": "bool",
    "default": true
  },
  "bot_name": {
    "description": "bot 在游戏里的名字",
    "type": "string",
    "default": "小鱼苗"
  },
  "bot_skill": {
    "description": "bot 的操作水平",
    "type": "float",
    "default": 0.75,
    "slider": {"min": 0.1, "max": 1.0, "step": 0.05},
    "hint": "太高会把人虐哭，0.6~0.8 比较合适。"
  },
  "comment_enabled": {
    "description": "让 bot 按人格设定点评/吐槽",
    "type": "bool",
    "default": true,
    "hint": "会调用一次大模型，用当前会话的默认人格。关掉则只发干巴巴的战报。"
  },
  "comment_on_selfplay": {
    "description": "自己玩完也点评",
    "type": "bool",
    "default": true
  },
  "comment_on_match": {
    "description": "群内对局结束后也点评",
    "type": "bool",
    "default": true
  },
  "persona_id": {
    "description": "点评使用的人格",
    "type": "string",
    "default": "",
    "_special": "select_persona",
    "hint": "留空 = 跟随当前会话的默认人格。"
  },
  "comment_style": {
    "description": "额外的点评风格要求",
    "type": "text",
    "default": "",
    "hint": "会追加到人格设定后面。例如：毒舌一点，喜欢拿输家开涮；多用鱼的比喻。"
  },
  "comment_max_chars": {
    "description": "点评字数上限",
    "type": "int",
    "default": 60,
    "slider": {"min": 20, "max": 200, "step": 10}
  },
  "idle_enabled": {
    "description": "空闲时让 bot 自己玩",
    "type": "bool",
    "default": true
  },
  "idle_minutes": {
    "description": "多久没人说话算「无聊」（分钟）",
    "type": "int",
    "default": 90,
    "slider": {"min": 10, "max": 720, "step": 10}
  },
  "idle_cooldown_minutes": {
    "description": "两次自娱之间的最小间隔（分钟）",
    "type": "int",
    "default": 120,
    "slider": {"min": 10, "max": 720, "step": 10}
  },
  "idle_daily_limit": {
    "description": "每天最多自娱几次",
    "type": "int",
    "default": 3,
    "slider": {"min": 0, "max": 24, "step": 1},
    "hint": "0 表示不限制。"
  },
  "report_umo": {
    "description": "战绩汇报到哪个会话",
    "type": "string",
    "default": "",
    "_special": "umo",
    "hint": "留空则汇报给最近一个私聊过 bot 的人。填了就不用先私聊。"
  },
  "selfplay_solo": {
    "description": "自娱时只自己一个人玩（没有对手）",
    "type": "bool",
    "default": false,
    "hint": "关掉（默认）时会给自己安排一个随机 AI 对手，这样才有输赢可汇报。"
  }
}
